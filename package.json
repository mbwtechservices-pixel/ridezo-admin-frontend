{
  "name": "ridezo-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Ridezo Admin Dashboard",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && vite build",
    "build:packages": "npm run build --workspace=@ridezo/types && npm run build --workspace=@ridezo/utils && npm run build --workspace=@ridezo/ui",
    "preview": "vite preview",
    "clean": "rm -rf dist *.tsbuildinfo node_modules/.tmp packages/*/dist",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "docker:build": "docker build -f docker/Dockerfile -t ridezo-admin ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@ridezo/types": "*",
    "@ridezo/ui": "*",
    "@ridezo/utils": "*",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-table": "^8.20.6",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "vite-plugin-pwa": "^0.21.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/jspdf": "^1.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
