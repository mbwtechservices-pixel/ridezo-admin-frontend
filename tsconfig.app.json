{
  "extends": "./packages/config/tsconfig.react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ridezo/types": ["./packages/types/src/index.ts"],
      "@ridezo/types/*": ["./packages/types/src/*"],
      "@ridezo/utils": ["./packages/utils/src/index.ts"],
