{
  "name": "@ridezo/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared UI component library for Ridezo platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
